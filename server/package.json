{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.jesuisapres.teleremo",
    "productName": "Teleremo",
    "npmRebuild": false,
    "files": [
      "main.js",
      "index.html",
      "icon.png",
      "src/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/@nut-tree-fork/**/*",
      "node_modules/@nut-tree/**/*",
      "icon.png"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "ismlahmt",
        "repo": "teleremo"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "win": {
      "target": "nsis"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "cors": "^2.8.6",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "jimp": "^1.6.1",
    "samsung-tv-remote": "^3.0.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
